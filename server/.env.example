# ==============================================================================
# ARGO OCEAN AI PLATFORM — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/argo_ocean_db?retryWrites=true&w=majority

# Optional Connection Pool Tuning
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# Security & Authentication
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_characters

# AI / ML Microservice (FastAPI Python Engine)
ML_SERVICE_URL=http://127.0.0.1:5001

# Allowed Frontend Origins (CORS whitelist, comma-separated)
CLIENT_URL=http://localhost:5173
