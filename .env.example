# ==============================================================================
# ARGO OCEAN AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the /server directory for local development.
# 2. For production deployments (e.g. Render, Railway, AWS, Heroku, Vercel),
#    set these environment variables in your deployment platform dashboard.
# 3. NEVER commit your actual '.env' file or production credentials to GitHub!
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# For Production (MongoDB Atlas):
# Replace <username>, <password>, and <cluster-name> with your Atlas cluster details.
# Ensure Network Access in Atlas is set to allow your deployment IP (or 0.0.0.0/0).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/argo_ocean_db?retryWrites=true&w=majority

# For Local Development (Fallback):
# MONGODB_URI=mongodb://127.0.0.1:27017/argo_ocean_db

# Optional Connection Pool Tuning
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Provide a cryptographically random string (at least 32 characters in production)
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_characters

# Optional LLM Key (if external Gemini API features are enabled)
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Microservice & Network Architecture
# ------------------------------------------------------------------------------
# AI / ML Microservice URL (FastAPI Python Engine)
# In production, point to your deployed Python service (e.g., https://argo-ml.onrender.com)
ML_SERVICE_URL=http://127.0.0.1:5001

# Allowed Frontend Origins for CORS Whitelisting
# Multiple domains can be comma-separated: https://argo-ocean.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
